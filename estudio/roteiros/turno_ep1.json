 "frases": [
  {
   "texto": "O ponto do escritório registrou oito entradas às três da manhã.",
   "destaque": [
    "oito entradas",
    "três da manhã"
   ],
   "pausa_voz": 0.9,
   "pausa": 0.8
  },
  {
   "texto": "Só tinha uma pessoa no prédio: o Rafa.",
   "destaque": [
    "uma pessoa"
   ],
   "pausa_voz": 0.9,
   "pausa": 0.72
  },
  {
   "texto": "Era a primeira noite dele no turno da madrugada.",
   "destaque": [
    "primeira noite"
   ],
   "pausa_voz": 0.9,
   "pausa": 0.72
  },
  {
   "texto": "O chefe tinha deixado uma única regra:",
   "destaque": [
    "única regra"
   ],
   "pausa_voz": 0.9,
   "pausa": 0.48
  },
  {
   "texto": "não olhe para as outras mesas depois das três.",
   "destaque": [
    "não olhe"
   ],
   "pausa_voz": 0.9,
   "pausa": 0.88
  },
  {
   "texto": "Às três e um, ele ouviu um teclado. Depois outro.",
   "destaque": [
    "teclado"
   ],
   "pausa_voz": 0.9,
   "pausa": 0.64
  },
  {
   "texto": "E mais outro.",
   "destaque": [
    "outro"
   ],
   "pausa_voz": 0.9,
   "pausa": 0.8
  },
  {
   "texto": "O Rafa levantou devagar.",
   "destaque": [
    "devagar"
   ],
   "pausa_voz": 0.9,
   "pausa": 0.72
  },
  {
   "texto": "Todas as mesas estavam ocupadas.",
   "destaque": [
    "ocupadas"
   ],
   "pausa_voz": 0.9,
   "pausa": 0.8
  },
  {
   "texto": "Gente de crachá antigo e pele cinza, de olhos fechados, digitando sem parar.",
   "destaque": [
    "pele cinza",
    "olhos fechados"
   ],
   "pausa_voz": 0.9,
   "pausa": 0.8
  },
  {
   "texto": "Quando ele olhou pra trás, alguém já estava sentado na cadeira dele.",
   "destaque": [
    "cadeira dele"
   ],
   "pausa_voz": 0.9,
   "pausa": 0.88
  },
  {
   "texto": "E na tela de todos, a mesma frase:",
   "destaque": [
    "mesma frase"
   ],
   "pausa_voz": 0.9,
   "pausa": 0.56
  },
  {
   "texto": "você é o nono.",
   "destaque": [
    "nono"
   ],
   "pausa_voz": 0.9,
   "pausa": 1.12
  },
  {
   "texto": "Aí, todos pararam de digitar. E abriram os olhos.",
   "destaque": [
    "abriram os olhos"
   ],
   "pausa_voz": 0.9,
   "pausa": 0.0
  }
 ],
