 "frases": [
  {
   "texto": "Os oito abriram os olhos ao mesmo tempo. Ninguém piscava.",
   "destaque": [
    "olhos",
    "Ninguém piscava"
   ],
   "pausa": 0.56
  },
  {
   "texto": "O Rafa correu pra porta.",
   "destaque": [
    "correu",
    "porta"
   ],
   "pausa": 0.35
  },
  {
   "texto": "Trancada. Pelo lado de fora.",
   "destaque": [
    "Trancada",
    "lado de fora"
   ],
   "pausa": 0.56
  },
  {
   "texto": "Atrás dele, os teclados voltaram a bater.",
   "destaque": [
    "teclados"
   ],
   "pausa": 0.49
  },
  {
   "texto": "Na tela da mesa dois, tinha uma ficha de contratação.",
   "destaque": [
    "mesa dois",
    "ficha de contratação"
   ],
   "pausa": 0.35
  },
  {
   "texto": "Turno da madrugada. Admissão: treze de novembro de dois mil e seis.",
   "destaque": [
    "madrugada",
    "treze de novembro de dois mil e seis"
   ],
   "pausa": 0.56
  },
  {
   "texto": "Todas as telas mostravam a mesma data.",
   "destaque": [
    "mesma data"
   ],
   "pausa": 0.49
  },
  {
   "texto": "Não era pra assustar o Rafa. Era pra completar a equipe.",
   "destaque": [
    "assustar",
    "completar a equipe"
   ],
   "pausa": 0.63
  },
  {
   "texto": "Na mesa cinco, a ficha do nono funcionário.",
   "destaque": [
    "nono funcionário"
   ],
   "pausa": 0.42
  },
  {
   "texto": "O nome era Rafael. A foto era a dele.",
   "destaque": [
    "Rafael",
    "dele"
   ],
   "pausa": 0.49
  },
  {
   "texto": "A mesma data. Vinte anos atrás.",
   "destaque": [
    "mesma data",
    "Vinte anos atrás"
   ],
   "pausa": 0.7
  },
  {
   "texto": "Aí, o relógio do ponto apitou.",
   "destaque": [
    "relógio do ponto"
   ],
   "pausa": 0.35
  },
  {
   "texto": "Nona entrada registrada. Três e nove da manhã.",
   "destaque": [
    "Nona entrada"
   ],
   "pausa": 0.49
  },
  {
   "texto": "Só que o Rafa não tinha batido o ponto.",
   "destaque": [
    "não tinha batido"
   ],
   "pausa": 0.56
  },
  {
   "texto": "Então quem acabou de entrar?",
   "destaque": [
    "quem acabou de entrar"
   ],
   "pausa": 0.0
  }
 ],
